{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://componentbench.com/schema/task.schema.json",
  "title": "ComponentBench Task",
  "description": "A single benchmark task: one canonical UI component interaction with a programmatic success condition.",
  "type": "object",
  "required": [
    "id",
    "name",
    "canonical_type",
    "implementation_source",
    "browsergym_goal",
    "scene_context",
    "difficulty",
    "success_trigger"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier, e.g. `button-antd-T01`. Format: <canonical_type>-<library>[-v2]-T<NN>. Library is antd/mui/mantine, or `external` for the 30 markdown-editor tasks implemented with an external component.",
      "pattern": "^[a-z0-9_]+-(antd|mui|mantine|external)(-v2)?-T[0-9]+$"
    },
    "name": { "type": "string", "description": "Short human-readable label." },
    "canonical_type": {
      "type": "string",
      "description": "One of the 97 canonical component types in the ontology (see metadata/canonical_components.csv)."
    },
    "implementation_source": {
      "type": "string",
      "enum": ["antd", "mui", "mantine", "external"],
      "description": "Underlying UI library used to instantiate the component (`external` = component from outside the three core libraries, e.g. the markdown editor)."
    },
    "implementation_variant": { "type": ["string", "null"] },
    "implementation_component": { "type": "string" },
    "task_template": { "type": "string" },
    "secondary_template": { "type": ["string", "null"] },
    "browsergym_goal": {
      "type": "string",
      "description": "Natural-language goal shown to the agent."
    },
    "ui_copy": { "type": "string" },
    "setup_description": { "type": "string" },
    "scene_context": {
      "type": "object",
      "required": ["theme", "spacing", "layout", "placement", "scale", "instances", "guidance", "clutter"],
      "properties": {
        "theme": { "enum": ["light", "dark", "high_contrast"] },
        "spacing": { "enum": ["comfortable", "compact"] },
        "layout": {
          "enum": [
            "isolated_card", "form_section", "settings_panel", "dashboard",
            "table_cell", "modal_flow", "drawer_flow",
            "dashboard_panel", "inline_surface", "nested_scroll", "panel_flow"
          ]
        },
        "placement": { "enum": ["center", "top_left", "top_right", "bottom_left", "bottom_right", "off_center"] },
        "scale": { "enum": ["default", "small", "large"] },
        "instances": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "pattern": "^([0-9]+|[0-9]+_plus)$" }
          ],
          "description": "Number of component instances rendered (integer, stringified integer, or `4_plus`)."
        },
        "guidance": { "enum": ["text", "visual", "mixed", "none"] },
        "clutter": { "enum": ["none", "low", "medium", "high"] }
      }
    },
    "difficulty": {
      "type": "object",
      "required": ["difficulty_bucket", "tier", "axes_ratings"],
      "properties": {
        "difficulty_bucket": { "enum": ["easy", "medium", "hard", "mid"] },
        "tier": { "enum": ["L0", "L1", "L2", "L3"] },
        "axes_ratings": {
          "type": "object",
          "required": [
            "precision_requirement", "target_acquisition", "density_choice_interference",
            "depth_layering", "feedback_dynamics", "semantic_observability", "disambiguation_load"
          ],
          "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 5 }
        },
        "justification": { "type": "string" }
      }
    },
    "success_trigger": {
      "type": "object",
      "required": ["human_readable", "canonical_predicate"],
      "properties": {
        "human_readable": {
          "type": ["array", "string"],
          "items": { "type": "string" },
          "description": "Human-readable description of what counts as success (list of bullet strings, or a single string)."
        },
        "canonical_predicate": {
          "type": "object",
          "required": ["predicate_type", "target_state"],
          "properties": {
            "predicate_type": { "type": "string", "description": "e.g. equals, contains, count_at_least" },
            "target_state": {
              "type": ["object", "array", "string", "number", "boolean", "null"],
              "additionalProperties": true,
              "description": "Target state for the predicate. Usually an object of key/value pairs; scalar or list forms are used by equals/set-membership predicates."
            },
            "tolerance": {},
            "require_confirm": { "type": "boolean" },
            "confirm_control": {
              "type": ["string", "object", "null"],
              "description": "Confirm control label, or an object with control_type/label."
            },
            "require_correct_instance": { "type": "boolean" },
            "target_instance_label_or_id": { "type": ["string", "null"] },
            "terminal_condition": { "type": ["string", "boolean"] }
          },
          "additionalProperties": true
        }
      }
    },
    "negative_cases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Concrete states/events that explicitly do not count as success."
    },
    "expected_interaction_path": {
      "type": ["string", "array"],
      "items": { "type": "string" },
      "description": "Reference interaction recipe (list of step strings, or a single string)."
    },
    "notes": { "type": ["string", "array", "null"], "items": { "type": "string" } }
  },
  "additionalProperties": true
}
